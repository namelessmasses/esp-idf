# Naming, descriptive identifiers, and replacing magic numbers with named
# constants are code review and linting concerns; clang-format cannot enforce
# them directly. It can preserve a blank line immediately after an opening
# brace, but it cannot require a blank line immediately before a closing
# brace.
BasedOnStyle: LLVM
UseTab: Never
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 80
AlignConsecutiveDeclarations: true
AlignConsecutiveAssignments: true
AlignConsecutiveMacros: true
AlignAfterOpenBracket: Align
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BinPackArguments: false
BinPackParameters: false
BreakBeforeBraces: Attach
IndentCaseLabels: false
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None
IncludeBlocks: Preserve
IncludeCategories:
  - Regex: '^"lvgl.h"$'
    Priority: -100
  - Regex: '^"freertos/FreeRTOS.h"$'
    Priority: -100
  - Regex: '.*'
    Priority: 1
